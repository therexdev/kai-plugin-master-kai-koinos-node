       \"(koinos.btype)\": \"CONTRACT_ID\"\n                }\n              },\n              \"wallet\": {\n                \"type\": \"bytes\",\n                \"id\": 3,\n                \"options\": {\n                  \"(koinos.btype)\": \"CONTRACT_ID\"\n                }\n              },\n              \"expiration\": {\n                \"type\": \"uint64\",\n                \"id\": 4,\n                \"options\": {\n                  \"jstype\": \"JS_STRING\"\n                }\n              }\n            }\n          },\n          \"request_new_signatures_arguments\": {\n            \"fields\": {\n              \"transactionId\": {\n                \"type\": \"string\",\n                \"id\": 1\n              },\n              \"operationId\": {\n                \"type\": \"string\",\n                \"id\": 2\n              }\n            }\n          },\n          \"get_transfer_status_arguments\": {\n            \"fields\": {\n              \"transactionId\": {\n                \"type\": \"bytes\",\n                \"id\": 1,\n                \"options\": {\n                  \"(koinos.btype)\": \"TRANSACTION_ID\"\n                }\n              }\n            }\n          },\n          \"tokens_locked_event\": {\n            \"fields\": {\n              \"from\": {\n                \"type\": \"bytes\",\n                \"id\": 1,\n                \"options\": {\n                  \"(koinos.btype)\": \"ADDRESS\"\n                }\n              },\n              \"token\": {\n                \"type\": \"bytes\",\n                \"id\": 2,\n                \"options\": {\n                  \"(koinos.btype)\": \"CONTRACT_ID\"\n                }\n              },\n              \"amount\": {\n                \"type\": \"string\",\n                \"id\": 3\n              },\n              \"payment\": {\n                \"type\": \"string\",\n                \"id\": 4\n              },\n              \"relayer\": {\n                \"type\": \"s