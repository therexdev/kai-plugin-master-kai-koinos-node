js":"/* Shared by the desktop and the browser signer. No network or key access. */\n(function (root, factory) {\n  if (typeof module === \"object\" && module.exports) module.exports = factory(require(\"koilib\"));\n  else root.KaiProducerValidation = factory(root);\n})(typeof globalThis !== \"undefined\" ? globalThis : this, function (koilib) {\n  \"use strict\";\n  const { Transaction, Signer, Contract, utils } = koilib;\n  const clone = value => JSON.parse(JSON.stringify(value));\n  const plain = value => !!value && typeof value === \"object\" && !Array.isArray(value);\n  const keys = (value, allowed) => plain(value) && Object.keys(value).every(key => allowed.includes(key));\n  function equal(a, b) {\n    if (a === b) return true;\n    if (!a || !b || typeof a !== \"object\" || typeof b !== \"object\" || Array.isArray(a) !== Array.isArray(b)) return false;\n    const ak = Object.keys(a), bk = Object.keys(b);\n    return ak.length === bk.length && ak.every(k => Object.hasOwn(b, k) && equal(a[k], b[k]));\n  }\n  function uint(value) {\n    if (typeof value !== \"string\" || !/^(0|[1-9][0-9]{0,19})$/.test(value) || BigInt(value) > 18446744073709551615n) throw new Error(\"Invalid mana limit or token amount.\");\n    return BigInt(value);\n  }\n  function shape(tx) {\n    if (!keys(tx, [\"id\", \"header\", \"operations\", \"signatures\"]) || JSON.stringify(tx).length > 100000 || typeof tx.id !== \"string\") throw new Error(\"Provide only transaction JSON, never a private key.\");\n    const h = tx.header;\n    if (!keys(h, [\"payer\", \"chain_id\", \"nonce\", \"rc_limit\", \"operation_merkle_root\"]) || [\"payer\", \"chain_id\", \"nonce\", \"operation_merkle_root\"].some(k => typeof h[k] !== \"string\" || !h[k])) throw new Error(\"Unsupported transaction header. Keep the original payer; disable Kondor free mana.\");\n    if (uint(h.rc_limit) <= 0n) throw new Error(\"Mana limit must be positive.\");\n    if (!Array.isArray(tx.operations) || tx.operations.length < 1 || tx.operations.length > 2 || tx.operations.some(op => !keys(op, [\"call_contract\"]) || !keys(op.call_contract, [\"contract_id\", \"entry_point\", \"args\"]) || typeof op.call_contract.contract_id !== \"string\" || !Number.isInteger(op.call_contract.entry_point) || typeof op.call_contract.args !== \"string\")) throw new Error(\"Unsupported producer operations.\");\n  }\n  async function hash(tx) {\n    const prepared = await Transaction.prepareTransaction(clone(tx));\n    if (prepared.id !== tx.id || prepared.header.operation_merkle_root !== tx.header.operation_merkle_root) throw new Error(\"Transaction hash differs from its contents. Nothing was broadcast.\");\n  }\n  function fresh(draft, now = Date.now()) {\n    if (draft?.signingWindow === \"offline-24h\" && (!Number.isSafeInteger(draft.createdAt) || draft.createdAt > now + 30000 || draft.expiresAt - draft.createdAt !== 24 * 60 * 60000)) throw new Error(\"Invalid offline signing window. Prepare a fresh transaction in KAI.\");\n    if (!draft || draft.format !== \"kai-producer-transaction-v1\" || !Number.isSafeInteger(draft.expiresAt) || draft.expiresAt <= now || draft.expiresAt > now + (draft.signingWindow === \"offline-24h\" ? 24 * 60 : 15) * 60000 + 30000) throw new Error(\"Invalid or expired draft. Prepare a fresh transaction in KAI.\");\n  }\n  async function validateSigned(draft, transaction) {\n    fresh(draft); shape(draft.transaction); shape(transaction);\n    if (draft.transaction.signatures?.length) throw new Error(\"The prepared draft must be unsigned.\");\n    const expected = clone(draft.transaction), actual = clone(transaction);\n    delete expected.signatures; delete actual.signatures;\n    // A wallet may reduce rc_limit and recalculate id. Everything else stays exact.\n    if (uint(actual.header.rc_limit) > uint(expected.header.rc_limit)) throw new Error(\"Kondor's mana limit exceeds the prepared maximum. Lower Max mana in Kondor and sign again.\");\n    actual.id = expected.id; actual.header.rc_limit = expected.header.rc_limit;\n    if (!equal(actual, expected)) throw new Error(\"Signed transaction differs from the prepared draft. Nothing was broadcast.\");\n    await hash(draft.transaction); await hash(transaction);\n    const signatures = transaction.signatures;\n    if (!Array.isArray(signatures) || signatures.length !== 1 || typeof signatures[0] !== \"string\" || signatures[0].length > 100) throw new Error(\"A single external producer signature is required.\");\n    let signers;\n    try { signers = await Signer.recoverAddresses(transaction); } catch { throw new Error(\"Invalid producer signature.\"); }\n    if (!signers.includes(draft.transaction.header.payer)) throw new Error(\"The signature does not belong to the external producer address.\");\n    return clone(transaction);\n  }\n  async function inspectDraft(draft, { chainId, contracts, pobAbi, tokenAbi }) {\n    fresh(draft); const tx = draft.transaction; shape(tx); await hash(tx);\n    if (tx.signatures?.length) throw new Error(\"Load the unsigned draft exported by KAI.\");\n    if (!chainId || tx.header.chain_id !== chainId) throw new Error(\"This draft does not match the network selected on the signing page.\");\n    const payer = tx.header.payer, operations = [], abis = {};\n    for (const op of tx.operations) {\n      const id = op.call_contract.contract_id;\n      const token = id === contracts.koin ? \"KOIN\" : id === contracts.vhp ? \"VHP\" : null;\n      const abi = id === contracts.pob ? pobAbi : token ? tokenAbi : null;\n      if (!abi) throw new Error(\"An operation uses an unrecognized contract for this network.\");\n      const contract = new Contract({ id, abi }), decoded = await contract.decodeOperation(op);\n      const permitted = id === contracts.pob ? [\"register_public_key\", \"burn\"] : token === \"KOIN\" ? [\"transfer\", \"approve\"] : [\"transfer\"];\n      if (!permitted.includes(decoded.name)) throw new Error(\"Unsupported producer operation.\");\n      const encoded = await contract.functions[decoded.name](decoded.args, { onlyOperation: true });\n      if (!equal(encoded.operation, op)) throw new Error(\"Operation contains noncanonical or unexpected fields.\");\n      operations.push({ contract: id, token, ...decoded }); abis[id] = abi;\n    }\n    const last = operations.at(-1), a = last.args;\n    let action;\n    if (last.name === \"register_public_key\" && operations.length === 1 && a.producer === payer && utils.decodeBase64url(a.public_key).length === 33) action = \"register\";\n    if (last.name === \"transfer\" && operations.length === 1 && a.from === payer && utils.isChecksumAddress(a.to) && uint(a.value) > 0n) action = \"transfer\";\n    if (last.name === \"burn\" && a.burn_address === payer && a.vhp_address === payer && uint(a.token_amount) > 0n) {\n      const approval = operations[0];\n      if (operations.length === 1 || (approval.name === \"approve\" && approval.token === \"KOIN\" && approval.args.owner === payer && approval.args.spender === contracts.pob && approval.args.value === a.token_amount)) action = \"burn\";\n    }\n    if (!action) throw new Error(\"Unexpected account, recipient, approval or producer operation sequence.\");\n    return { action, payer, chainId, nonce: tx.header.nonce, id: tx.id, manaLimitSatoshis: tx.header.rc_limit, operations, abis };\n  }\n  return { validateSigned, inspectDraft, fresh, equal };\n});\n","style.css":"/* Original Koinos Node workspace, with the shared KAI light theme. */\n:root{color-scheme:light;--bg:#f4f7fd;--panel:#fff;--line:#dce5f2;--border:#dce5f2;--text:#14284e;--muted:#61728d;--accent:#155eef;font:14px/1.6 Inter,\"Segoe UI\",Arial,sans-serif;color:var(--text);background:var(--bg)}\n*{box-sizing:border-box}body{margin:0;height:100dvh;min-height:500px;display:flex;flex-direction:column;overflow:hidden}button,input,select{font:inherit}button{border:1px solid var(--line);border-radius:9px;padding:9px 14px;background:#fff;color:var(--text);font-size:12px;font-weight:550;cursor:pointer}button:hover:not(:disabled){background:#edf4ff;border-color:#b7cff6}button:disabled{opacity:.5;cursor:not-allowed}button.primary{background:var(--accent);border-color:var(--accent);color:#fff}button.primary:hover:not(:disabled){background:#0c4ed3}button:focus-visible,select:focus-visible{outline:2px solid var(--accent);outline-offset:3px}select{min-width:0;border:1px solid var(--line);border-radius:9px;padding:10px 12px;background:#f5f8fe;color:var(--text);font-size:12px}label{display:block;color:var(--muted);font-size:12px;margin-bottom:7px}h1,h2,h3,p{margin:0}h3{font-size:16px;font-weight:650;letter-spacing:-.25px;line-height:1.4;margin-bottom:16px}.workspace-header{display:flex;align-items:center;gap:11px;height:74px;min-height:74px;padding:0 30px;border-bottom:1px solid var(--line);background:var(--bg)}.workspace-header h1{font-size:15px;font-weight:650}.workspace-header>svg{width:20px;height:20px;fill:none;stroke:var(--accent);stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.workspace-caption{margin-left:auto;font-size:10px;color:var(--muted);text-align:right}.kn-shell{flex:1;min-height:0;display:grid;grid-template-columns:208px minmax(0,1fr)}.kc-rail{display:flex;flex-direction:column;min-width:0;padding:20px 14px;background:#fafcff;border-right:1px solid var(--line);overflow:auto}.kc-rail-label{font-size:9px;letter-spacing:1.2px;text-transform:uppercase;color:var(--muted);padding:6px 4px;margin:10px 2px 9px}.kc-rail nav{display:grid;gap:5px}.kc-item{width:100%;text-align:left;border-color:transparent;background:transparent;font-size:12px;padding:10px 12px}.kc-item.on{background:#eaf2ff;border-color:#c4d9fb;color:var(--accent)}.kc-rail-foot{margin-top:auto;padding-top:16px;border-top:1px solid var(--line)}.kc-rail-foot .hint{margin-top:10px}.kc-pane{min-width:0;overflow:auto;padding:29px 30px 45px}.node-page{max-width:1100px;margin:0 auto}.page-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;margin:0 0 22px}.page-heading h2{font-size:28px;letter-spacing:-.8px;font-weight:650;line-height:1.3}.lead{font-size:12px;line-height:1.8;color:var(--muted);margin:-8px 0 23px}.card{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:23px;margin-bottom:20px;min-width:0}.spread,.section-title{display:flex;align-items:center;justify-content:space-between;gap:16px}.section-title{margin-bottom:16px}.section-title h3{margin:0}.actions{display:flex;flex-wrap:wrap;gap:9px;align-items:center}.status-line{display:flex;align-items:center;gap:9px;font-size:18px}.status-line strong{font-weight:600}.status-dot{width:8px;height:8px;background:#8391a5;border-radius:50%;flex:none}.status-dot.running{background:#168469}.hint{font-size:11px;line-height:1.6;color:var(--muted)}#checked{margin-top:7px}.lifecycle-note{margin-top:18px}.widget-grid{display:grid;grid-template-columns:minmax(145px,.8fr) minmax(0,1.5fr);gap:14px}.tile{padding:19px;border:1px solid #e2ebf8;background:#f7faff;border-radius:13px;min-width:0}.tile-label{display:block;font-size:10px;letter-spacing:1px;text-transform:uppercase;color:var(--muted)}.tile>strong{display:block;font-size:24px;letter-spacing:-.6px;color:#1855a3;margin:8px 0}.tile>.hint{display:block;overflow-wrap:anywhere}.path{font:12px/1.7 Consolas,ui-monospace,monospace;color:#365d8a;overflow-wrap:anywhere;margin:10px 0 16px}.pill{display:inline-block;border:1px solid #dae6f8;border-radius:30px;padding:4px 10px;background:#f5f9ff;color:var(--muted);font-size:10px;white-space:nowrap}.empty{font-size:12px;line-height:1.7;color:var(--muted);padding:15px 0}.service-row{display:flex;justify-content:space-between;align-items:center;gap:15px;border-bottom:1px solid #e2eaf6;padding:12px 0;font-size:12px;overflow-wrap:anywhere}.service-row:last-child{border-bottom:0}.service-row span{color:var(--muted);text-align:right}.log-controls{display:flex;gap:8px;align-items:center}.log-controls select{max-width:150px;font-size:11px;padding:8px 10px}.log-output{background:#102441;color:#dcecff;border:1px solid #284362;border-radius:12px;padding:17px;min-height:150px;max-height:380px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;font:11px/1.8 Consolas,ui-monospace,monospace;margin:0}.form-row{display:flex;gap:10px;align-items:center;margin-bottom:14px}.form-row select{flex:1;max-width:430px}.form-row button{flex:none}#setupStatus{margin-bottom:17px}#message{max-width:1100px;margin:0 auto 18px;padding:11px 14px;background:#eaf2ff;border:1px solid #c6d9f9;color:#184b9c;border-radius:10px;font-size:12px;overflow-wrap:anywhere}#message.error{background:#fff0f2;border-color:#f0c4cc;color:#a33040}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}[hidden]{display:none!important}\n@media(max-width:900px){.kn-shell{grid-template-columns:156px minmax(0,1fr)}.kc-pane{padding:24px 22px 40px}.card{padding:20px}.status-card .spread{align-items:flex-start;flex-direction:column}.widget-grid{grid-template-columns:1fr}.workspace-caption{max-width:230px}}\n@media(max-width:600px){.workspace-header{padding:0 18px;height:65px;min-height:65px}.workspace-caption{display:none}.kn-shell{grid-template-columns:1fr;grid-template-rows:auto minmax(0,1fr)}.kc-rail{padding:8px 12px;border-right:0;border-bottom:1px solid var(--line);overflow:visible}.kc-rail nav{display:flex;gap:5px}.kc-item{width:auto;font-size:11px;padding:8px 10px}.kc-rail-label,.kc-rail-foot{display:none}.kc-pane{padding:20px 16px 35px}.page-heading h2{font-size:25px}.card{padding:18px}.section-title{align-items:flex-start;flex-wrap:wrap}.form-row{align-items:stretch;flex-direction:column}.form-row button{align-self:flex-start}}\n","styles.css":":root {\n  --bg: #0b0f17;\n  --bg-2: #101624;\n  --card: #161e30;\n  --card-2: #1c2740;\n  --border: #263452;\n  --text: #e8edf7;\n  --muted: #8b98b8;\n  --accent: #38bdf8;\n  --accent-2: #818cf8;\n  --good: #34d399;\n  --warn: #fbbf24;\n  --bad: #f87171;\n  --mono: \"SFMono-Regular\", Consolas, \"Liberation Mono\", Menlo, monospace;\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\n\nhtml, body { height: 100%; }\n\nbody {\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Ubuntu, sans-serif;\n  background: var(--bg);\n  color: var(--text);\n  font-size: 14px;\n  overflow: hidden;\n}\n\n#app { display: flex; height: 100vh; }\n\n/* ---------- sidebar ---------- */\n#sidebar {\n  width: 220px;\n  min-width: 220px;\n  background: var(--bg-2);\n  border-right: 1px solid var(--border);\n  display: flex;\n  flex-direction: column;\n  padding: 18px 12px;\n}\n\n.brand { display: flex; align-items: center; gap: 10px; padding: 0 8px 18px; }\n.brand-mark {\n  font-size: 26px;\n  background: linear-gradient(135deg, var(--accent), var(--accent-2));\n  -webkit-background-clip: text;\n  background-clip: text;\n  color: transparent;\n}\n.brand-name { font-weight: 700; letter-spacing: 0.3px; }\n.brand-sub { font-size: 11px; color: var(--muted); }\n\n#nav { display: flex; flex-direction: column; gap: 4px; flex: 1; }\n.nav-item {\n  text-align: left;\n  padding: 10px 12px;\n  background: none;\n  border: none;\n  border-radius: 8px;\n  color: var(--muted);\n  font-size: 13.5px;\n  cursor: pointer;\n}\n.nav-item:hover { background: var(--card); color: var(--text); }\n.nav-item.active { background: var(--card-2); color: var(--text); font-weight: 600; }\n\n.sidebar-foot { display: flex; align-items: center; gap: 8px; padding: 8px; }\n\n/* ---------- main ---------- */\n#main { flex: 1; overflow-y: auto; padding: 26px 30px 60px; }\n.view { display: none; max-width: 900px; }\n.view.active { display: block; }\n\nh1 { font-size: 20px; margin-bottom: 4px; }\nh2 { font-size: 15px; margin-bottom: 10px; }\n.lead { color: var(--muted); margin-bottom: 20px; }\n\n.card {\n  background: var(--card);\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  padding: 18px;\n  margin-bottom: 16px;\n}\n.card h2 { display: flex; align-items: center; gap: 8px; }\n.card .hint { font-size: 12.5px; color: var(--muted); margin-top: 6px; line-height: 1.5; }\n\n.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }\n.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }\n@media (max-width: 900px) { .grid-2, .grid-3 { grid-template-columns: 1fr; } }\n\n.row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }\n.spread { justify-content: space-between; }\n.stack { display: flex; flex-direction: column; gap: 10px; }\n\n/* ---------- widgets ---------- */\n.stat { background: var(--bg-2); border: 1px solid var(--border); border-radius: 10px; padding: 14px; }\n.stat .label { font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.8px; color: var(--muted); }\n.stat .value { font-family: var(--mono); font-size: 20px; margin-top: 6px; word-break: break-all; }\n.stat .sub { font-size: 12px; color: var(--muted); margin-top: 4px; }\n\n.pill {\n  display: inline-flex; align-items: center; gap: 6px;\n  padding: 3px 10px; border-radius: 999px; font-size: 11.5px; font-weight: 600;\n  background: var(--card-2); color: var(--muted); border: 1px solid var(--border);\n}\n.pill.good { color: var(--good); border-color: rgba(52, 211, 153, 0.4); }\n.pill.warn { color: var(--warn); border-color: rgba(251, 191, 36, 0.4); }\n.pill.bad { color: var(--bad); border-color: rgba(248, 113, 113, 0.4); }\n.pill.accent { color: var(--accent); border-color: rgba(56, 189, 248, 0.4); }\n\n.mono { font-family: var(--mono); }\n.muted { color: var(--muted); font-size: 12.5px; }\n.small { font-size: 12px; }\n\n.addr {\n  font-family: var(--mono); font-size: 13px; background: var(--bg-2);\n  padding: 8px 12px; border-radius: 8px; border: 1px solid var(--border);\n  word-break: break-all;\n}\n\n/* ---------- forms ---------- */\nlabel.field { display: block; margin-bottom: 12px; }\nlabel.field > span { display: block; font-size: 12.5px; color: var(--muted); margin-bottom: 5px; }\n\ninput[type=\"text\"], input[type=\"url\"], input[type=\"password\"], input[type=\"number\"], select, textarea {\n  width: 100%;\n  background: var(--bg-2);\n  color: var(--text);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  padding: 9px 12px;\n  font-size: 13.5px;\n  font-family: inherit;\n}\ninput.mono, textarea.mono { font-family: var(--mono); }\ninput:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent); }\ninput[type=\"range\"] { width: 100%; accent-color: var(--accent); }\ninput[type=\"checkbox\"] { accent-color: var(--accent); width: 15px; height: 15px; }\n\nbutton.btn {\n  padding: 9px 16px;\n  border-radius: 8px;\n  border: 1px solid var(--border);\n  background: var(--card-2);\n  color: var(--text);\n  font-size: 13.5px;\n  font-weight: 600;\n  cursor: pointer;\n}\nbutton.btn:hover { border-color: var(--accent); }\nbutton.btn.primary {\n  background: linear-gradient(135deg, #0ea5e9, #6366f1);\n  border: none;\n}\nbutton.btn.primary:hover { filter: brightness(1.12); }\nbutton.btn.danger { background: rgba(248, 113, 113, 0.12); color: var(--bad); border-color: rgba(248, 113, 113, 0.4); }\nbutton.btn.ghost { background: none; }\nbutton.btn:disabled { opacity: 0.45; cursor: not-allowed; filter: none; }\nbutton.link {\n  background: none; border: none; color: var(--accent); cursor: pointer; font-size: 12.5px; padding: 0;\n}\nbutton.link:hover { text-decoration: underline; }\n\n/* ---------- tables / logs ---------- */\ntable { width: 100%; border-collapse: collapse; font-size: 12.5px; }\nth { text-align: left; color: var(--muted); font-weight: 600; padding: 6px 8px; border-bottom: 1px solid var(--border); }\ntd { padding: 7px 8px; border-bottom: 1px solid rgba(38, 52, 82, 0.5); }\n\npre.logs {\n  background: #05080f;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  padding: 12px;\n  font-family: var(--mono);\n  font-size: 11.5px;\n  line-height: 1.55;\n  max-height: 320px;\n  overflow: auto;\n  white-space: pre-wrap;\n  word-break: break-all;\n  color: #a7b6d4;\n}\n\n.progress { height: 8px; background: var(--bg-2); border-radius: 999px; overflow: hidden; border: 1px solid var(--border); }\n.progress > div { height: 100%; background: linear-gradient(90deg, var(--accent), var(--accent-2)); transition: width 0.4s; }\n\n/* ---------- dashboard ---------- */\n.status-card { border-color: var(--border); }\n.status-line { display: flex; align-items: center; gap: 10px; font-size: 18px; font-weight: 700; }\n.status-text.good-text { color: var(--good); }\n.status-text.bad-text { color: var(--bad); }\n.status-text.warn-text { color: var(--warn); }\n.dot { width: 12px; height: 12px; border-radius: 50%; display: inline-block; }\n.dot.green { background: var(--good); box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.7); animation: pulse 2s infinite; }\n.dot.red { background: var(--bad); box-shadow: 0 0 8px rgba(248, 113, 113, 0.6); }\n.dot.amber { background: var(--warn); }\n@keyframes pulse {\n  0% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.6); }\n  70% { box-shadow: 0 0 0 10px rgba(52, 211, 153, 0); }\n  100% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0); }\n}\n\n.widget-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));\n  gap: 12px;\n  margin-bottom: 16px;\n}\n.tile {\n  background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px;\n}\n.tile.accent { border-color: rgba(56, 189, 248, 0.3); }\n.tile.good { border-color: rgba(52, 211, 153, 0.3); }\n.tile .t-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.7px; color: var(--muted); }\n.tile .t-value { font-family: var(--mono); font-size: 19px; margin-top: 6px; word-break: break-all; }\n.tile.good .t-value { color: var(--good); }\n.tile .t-sub { font-size: 11px; color: var(--muted); margin-top: 3px; }\n\n.feed { display: flex; flex-direction: column; gap: 2px; max-height: 340px; overflow-y: auto; }\n.feed-row {\n  display: grid;\n  grid-template-columns: 24px 1.4fr 1fr 1fr 1fr auto;\n  align-items: center; gap: 8px;\n  padding: 8px 10px; border-radius: 8px; font-size: 12.5px;\n}\n.feed-row:nth-child(odd) { background: var(--bg-2); }\n.feed-row.link { cursor: pointer; }\n.feed-row.link:hover { background: var(--card-2); }\n.fr-ico { text-align: center; }\n.fr-main { color: var(--text); }\n.fr-metric { font-family: var(--mono); font-size: 12px; text-align: right; white-space: nowrap; }\n.fr-metric.burn { color: var(--warn); }\n.fr-metric.reward { color: var(--accent); }\n.fr-metric.profit { color: var(--good); }\n.fr-time { color: var(--muted); font-size: 11px; text-align: right; white-space: nowrap; }\n@media (max-width: 720px) {\n  .feed-row { grid-template-columns: 20px 1fr auto; }\n  .feed-row .fr-metric.burn, .feed-row .fr-metric.reward { display: none; }\n}\n\n.setup-card { border-color: rgba(56, 189, 248, 0.35); }\n.setup-steps { display: flex; flex-direction: column; gap: 8px; margin-top: 12px; }\n.setup-step {\n  display: flex; align-items: center; gap: 14px;\n  padding: 12px 14px; border-radius: 10px;\n  background: var(--bg-2); border: 1px solid var(--border);\n}\n.setup-step.active { border-color: rgba(56, 189, 248, 0.5); }\n.setup-step.done { opacity: 0.7; }\n.setup-step.pending { opacity: 0.5; }\n.setup-ico { font-size: 18px; width: 24px; text-align: center; flex-shrink: 0; }\n.setup-body { flex: 1; min-width: 0; }\n.setup-title { font-weight: 600; font-size: 14px; }\n.setup-detail { color: var(--muted); font-size: 12.5px; margin-top: 2px; line-height: 1.45; }\n.setup-act { flex-shrink: 0; }\n.setup-act .btn { padding: 8px 14px; font-size: 13px; }\n\n.checklist { list-style: none; }\n.checklist li { display: flex; gap: 10px; padding: 7px 0; align-items: flex-start; font-size: 13px; }\n.checklist .tick { width: 20px; text-align: center; }\n\n.banner { border-radius: 10px; padding: 12px 14px; font-size: 13px; margin-bottom: 14px; border: 1px solid; line-height: 1.5; }\n.banner.warn { background: rgba(251, 191, 36, 0.08); border-color: rgba(251, 191, 36, 0.35); color: #fde68a; }\n.banner.bad { background: rgba(248, 113, 113, 0.08); border-color: rgba(248, 113, 113, 0.35); color: #fecaca; }\n.banner.info { background: rgba(56, 189, 248, 0.07); border-color: rgba(56, 189, 248, 0.3); color: #bae6fd; }\n\n.wif-box {\n  font-family: var(--mono); font-size: 13px; background: rgba(251, 191, 36, 0.07);\n  border: 1px dashed rgba(251, 191, 36, 0.5); color: #fde68a;\n  border-radius: 8px; padding: 12px; word-break: break-all; margin: 10px 0;\n}\n\n/* ---------- toasts ---------- */\n#toasts { position: fixed; right: 18px; bottom: 18px; display: flex; flex-direction: column; gap: 8px; z-index: 60; max-width: 380px; }\n.toast {\n  background: var(--card-2); border: 1px solid var(--border); border-left: 3px solid var(--accent);\n  border-radius: 8px; padding: 11px 14px; font-size: 12.5px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);\n  animation: slide-in 0.18s ease-out;\n  word-break: break-word;\n}\n.toast.good { border-left-color: var(--good); }\n.toast.bad { border-left-color: var(--bad); }\n.toast.warn { border-left-color: var(--warn); }\n@keyframes slide-in { from { transform: translateX(30px); opacity: 0; } to { transform: none; opacity: 1; } }\n\n/* ---------- modal ---------- */\n.modal-backdrop {\n  position: fixed; inset: 0; background: rgba(4, 7, 13, 0.72); z-index: 50;\n  display: flex; align-items: center; justify-content: center;\n}\n.modal {\n  background: var(--card); border: 1px solid var(--border); border-radius: 14px;\n  padding: 22px; width: min(480px, 92vw); max-height: 86vh; overflow-y: auto;\n  box-shadow: 0 18px 60px rgba(0, 0, 0, 0.6);\n}\n.modal h2 { margin-bottom: 12px; }\n.modal .actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 18px; }\n\n.spin {\n  display: inline-block; width: 13px; height: 13px; border-radius: 50%;\n  border: 2px solid var(--border); border-top-color: var(--accent);\n  animation: spin 0.8s linear infinite; vertical-align: -2px;\n}\n@keyframes spin { to { transform: rotate(360deg); } }\n\n::-webkit-scrollbar { width: 10px; height: 10px; }\n::-webkit-scrollbar-thumb { background: var(--card-2); border-radius: 8px; }\n::-webkit-scrollbar-track { background: transparent; }\n\n/* State-dependent controls must stay hidden despite button display styles. */\n[hidden] { display: none !important; }\n\n/* Producer wallet connection */\n.custody-vault { margin: 20px 0; padding: 18px; border: 1px solid var(--border, #384659); border-radius: 14px; }\n.custody-vault h3 { margin: 0 0 8px; }\n.custody-vault .mono, #pc-vault-status { overflow-wrap: anywhere; }\n#pc-vault-qr { max-width: 290px; margin: 16px 0; }\n#pc-vault-qr svg { display: block; width: 100%; height: auto; }\n.custody-vault [hidden] { display: none !important; }\n"},"publicKey":"MCowBQYDK2VwAyEAujPt2xYcqLkorZIdmrBEa0ZlLml+yEERDhP+YtI2t5o=","signature":"H06F4AvxkA5K3yZVZ2Vfo+2/YLOArH6CQSLcs4lHzmlJWfx01US7e1Ch9pX4j08vZ3wOdd/An5WwLQbTwtlRAA=="}